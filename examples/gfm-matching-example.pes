base:
  s_base: 2000000.0
  v_ll_rms: 690.0
  f0: 50.0
buses:
  pcc:
    c_pu: 0.02
    r_d_pu: 0.5
sources:
  grid:
    bus: pcc
    x_pu: 0.4
    r_pu: 0.04
units:
  vsc:
    bus: pcc
    ac_filter:
      l_f_pu: 0.2
      r_f_pu: 0.01
    dclink:
      vdc_ref: 1500.0
      capacitor:
        c_pu: 350.0
        r_esr_pu: 0.001
      source:
        type: current
        i_pu: 0.5
        k_pu: 9.5
    pwm:
      f_sw: 20000.0
      modulation_limit: 0.95
      carrier_phase: 0.0
    control:
      type: gfm
      loops:
        power:
          type: power
          period: 5.0e-05
          filter: {enable: 0}
        sync:
          type: matching
          period: 5.0e-05
          k_theta_pu: null
          k_q_pu: 0.05
        impedance:
          type: virtual_impedance
          r_v_pu: 0.0
          x_v_pu: 0.0
      references:
        p_ref_pu: 0.0
        q_ref_pu: 0.0
        v_ref_pu: 1.0
    delay:
      steps: 1
    protection:
      overcurrent: {enable: 1, limit_pu: 1.5}
events:
  connect_vsc: {type: connect, target: vsc, t: 0.2, ramp: 1.0}
  grid_f: {type: set, t: 4.0, set: {sources.grid.f: 49.8}}
simulation:
  t_end: 6.0
  bridge: averaged
  solver:
    type: fixed
    method: rk4
    dt: 1.25e-05
  initial:
    t: 0.0           # default: capacitors at 1 pu, every other state 0
  output:
    period: 0.0005
    control_every: 10
    states: 1
    signals: 0
  stop_on_trip: 1
